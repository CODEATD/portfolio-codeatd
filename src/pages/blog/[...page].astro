---
import type { GetStaticPaths, Page } from "astro";
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CategoryChips from "@/components/blog/CategoryChips.astro";
import PostCard from "@/components/blog/PostCard.astro";
import BlogGridReveal from "@/components/blog/BlogGridReveal.astro";
import Pagination from "@/components/blog/Pagination.astro";
import { getPageBySlug, getPostType, toPlainText, withPagePrefix } from "@/helpers";
import {
  CategoriesSchema,
  PostsSchema,
  SectionPageSchema,
  type Category,
  type Post,
  type SectionPage,
} from "@/types";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));

//* SSG: /blog, /blog/page/2, /blog/page/3… (6 posts per page)
export const getStaticPaths = (async ({ paginate }) => {
  const posts = PostsSchema.parse(await getPostType("posts"));
  const categories = CategoriesSchema.parse(
    await getPostType("categories", "&hide_empty=true"),
  );
  const blogPage = SectionPageSchema.parse(await getPageBySlug("blog"));

  // props → the same data on every page, fetched once · /blog, /blog/page/2…
  return withPagePrefix(paginate(posts, { pageSize: 6, props: { categories, blogPage } }));
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  categories: Category[];
  blogPage: SectionPage;
}

const { page, categories, blogPage } = Astro.props;
const { title, acf, content } = blogPage;
const pageTitle = page.currentPage === 1 ? "Blog" : `Blog · ${t("blog.page")} ${page.currentPage}`;
---

<Layout title={pageTitle} description={toPlainText(content.rendered) || undefined}>
  <section aria-labelledby="blog-title" class="pb-20 sm:pb-28 lg:pb-30" data-blog-reveal>
    <PageHero
      crumbs={[{ name: t("breadcrumb.home"), href: "/" }, { name: title.rendered }]}
      id="blog-title"
      label={title.rendered}
      heading={acf.heading}
      intro={content.rendered}
      itemClass="blog-reveal-item"
    >
      <CategoryChips class="blog-reveal-item mt-12" categories={categories} />
    </PageHero>

    <!-- Posts -->
    {
      page.data.length > 0 ? (
        <ul class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {page.data.map((post) => (
            <li>
              <PostCard post={post} headingLevel="h2" />
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-12 text-neutral-300 dark:text-neutral-100">{t("blog.empty")}</p>
      )
    }

    <Pagination page={page} />
  </section>
  <BlogGridReveal />
</Layout>
