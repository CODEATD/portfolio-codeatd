---
import type { GetStaticPaths, Page } from "astro";
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import CategoryChips from "@/components/blog/CategoryChips.astro";
import PostCard from "@/components/blog/PostCard.astro";
import Pagination from "@/components/blog/Pagination.astro";
import { getPageBySlug, getPostType, toPlainText } from "@/helpers";
import {
  CategoriesSchema,
  PostsSchema,
  SectionPageSchema,
  type Category,
  type Post,
  type SectionPage,
} from "@/types";

//* SSG: /blog, /blog/2, /blog/3… (6 posts per page)
export const getStaticPaths = (async ({ paginate }) => {
  const posts = PostsSchema.parse(await getPostType("posts"));
  const categories = CategoriesSchema.parse(
    await getPostType("categories", "&hide_empty=true"),
  );
  const blogPage = SectionPageSchema.parse(await getPageBySlug("blog"));

  // props → the same data on every page, fetched once
  return paginate(posts, { pageSize: 6, props: { categories, blogPage } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  categories: Category[];
  blogPage: SectionPage;
}

const { page, categories, blogPage } = Astro.props;
const { title, acf, content } = blogPage;
const pageTitle = page.currentPage === 1 ? "Blog" : `Blog · Page ${page.currentPage}`;
---

<Layout title={pageTitle} description={toPlainText(content.rendered) || undefined}>
  <section aria-labelledby="blog-title" class="pt-12 pb-20 sm:pt-16 sm:pb-28 lg:pb-30">
    <Breadcrumb items={[{ name: "Home", href: "/" }, { name: title.rendered }]} />

    <!-- Label + h1 + intro -->
    <div class="mt-10 grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-8">
      <SectionHeading
        as="h1"
        class="lg:col-span-7"
        id="blog-title"
        label={title.rendered}
        heading={acf.heading}
        headingClass="sm:text-5xl lg:text-6xl"
      />
      {
        content.rendered && (
          <div
            class="rich-text text-sm leading-relaxed text-pretty text-neutral-400 sm:text-base lg:col-span-4 lg:col-start-9 dark:text-neutral-50"
            set:html={content.rendered}
          />
        )
      }
    </div>

    <CategoryChips class="mt-12" categories={categories} />

    <!-- Posts -->
    {
      page.data.length > 0 ? (
        <ul class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {page.data.map((post) => (
            <li>
              <PostCard post={post} headingLevel="h2" />
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-12 text-neutral-300 dark:text-neutral-100">No posts yet. Check back soon.</p>
      )
    }

    <Pagination page={page} />
  </section>
</Layout>
