---
import type { GetStaticPaths, Page } from "astro";
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CategoryChips from "@/components/blog/CategoryChips.astro";
import PostCard from "@/components/blog/PostCard.astro";
import BlogGridReveal from "@/components/blog/BlogGridReveal.astro";
import Pagination from "@/components/blog/Pagination.astro";
import { getPostType, toPlainText, withPagePrefix } from "@/helpers";
import { CategoriesSchema, PostsSchema, type Category, type Post } from "@/types";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));

//* SSG: /blog/category/astro, /blog/category/astro/page/2…
export const getStaticPaths = (async ({ paginate }) => {
  const posts = PostsSchema.parse(await getPostType("posts"));
  const categories = CategoriesSchema.parse(
    await getPostType("categories", "&hide_empty=true"),
  );

  // One paginated group per category (filtered here: no extra fetch per category)
  return categories.flatMap((category) => {
    const categoryPosts = posts.filter((post) =>
      post.categories.some(({ slug }) => slug === category.slug),
    );

    return withPagePrefix(
      paginate(categoryPosts, {
        pageSize: 6,
        params: { slug: category.slug },
        props: { category, categories },
      }),
    );
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  category: Category;
  categories: Category[];
}

const { page, category, categories } = Astro.props;
const name = toPlainText(category.name); // "CSS &amp; Design" → "CSS & Design"
const postsLabel = `${category.count} ${category.count === 1 ? t("blog.post") : t("blog.posts")}`;
---

<Layout
  title={`${name} · Blog`}
  description={`${postsLabel} ${t("blog.about")} ${name} · Blog de CODE ATD`}
>
  <section aria-labelledby="blog-title" class="pb-20 sm:pb-28 lg:pb-30" data-blog-reveal>
    <PageHero
      crumbs={[
        { name: t("breadcrumb.home"), href: "/" },
        { name: "Blog", href: "/blog" },
        { name: category.name },
      ]}
      id="blog-title"
      label={`${t("blog.category")} · ${postsLabel}`}
      heading={name}
      itemClass="blog-reveal-item"
    >
      <CategoryChips class="blog-reveal-item mt-12" categories={categories} current={category.slug} />
    </PageHero>

    <ul class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {
        page.data.map((post) => (
          <li>
            <PostCard post={post} headingLevel="h2" />
          </li>
        ))
      }
    </ul>

    <Pagination page={page} />
  </section>
  <BlogGridReveal />
</Layout>