---
// Layout
import Layout from "@/layouts/Layout.astro";

// Components
import Hero from "@/components/hero/Hero.astro";
import LogoMarquee from "@/components/ui/LogoMarquee.astro";
import About from "@/components/about/About.astro";
import Stack from "@/components/stack/Stack.astro";
import Experience from "@/components/experience/Experience.astro";
import Projects from "@/components/projects/Projects.astro";
import Showreel from "@/components/showreel/Showreel.astro";
import Testimonials from "@/components/testimonials/Testimonials.astro";
import Faq from "@/components/faq/Faq.astro";
import Blog from "@/components/blog/Blog.astro";

// Helpers
import { getOptions, getPageBySlug, getPostType } from "@/helpers";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

// Types
import {
  AboutPageSchema,
  BaseWPSchema,
  ExperiencesSchema,
  FaqsSchema,
  OptionsSchema,
  PostsSchema,
  ProjectsSchema,
  SectionPageSchema,
  StackPageSchema,
  ShowreelPageSchema,
  TestimonialsSchema,
} from "@/types";
import bg from "@/assets/backgrounds/bg-pattern-dark.avif";

// All WordPress requests at once (one after another they took ~2.8 s per visit in dev)
const [
  optionsJson,
  aboutJson,
  stackJson,
  experiencePageJson,
  experiencesJson,
  projectsPageJson,
  projectsJson,
  showreelJson,
  testimonialsPageJson,
  testimonialsJson,
  faqPageJson,
  faqsJson,
  blogPageJson,
  postsJson,
] = await Promise.all([
  getOptions(),
  getPageBySlug("about"),
  getPageBySlug("stack"),
  getPageBySlug("experience"),
  getPostType("experience"),
  getPageBySlug("projects"),
  getPostType("project"),
  getPageBySlug("showreel"),
  getPageBySlug("testimonials"),
  getPostType("testimonial"),
  getPageBySlug("faq"),
  getPostType("faq", "&orderby=menu_order&order=asc"),
  getPageBySlug("blog"),
  getPostType("posts"),
]);

const t = useTranslations(getLangFromUrl(Astro.url));

const options = OptionsSchema.parse(optionsJson);
const { hero } = options;
const about = AboutPageSchema.parse(aboutJson);
const stack = StackPageSchema.parse(stackJson);
const experiencePage = SectionPageSchema.parse(experiencePageJson);
const experiences = ExperiencesSchema.parse(experiencesJson);
const projectsPage = SectionPageSchema.parse(projectsPageJson);
const projects = ProjectsSchema.parse(projectsJson);
const homeProjects = projects.slice(0, 4); // home: the 4 most recent
const showreel = ShowreelPageSchema.parse(showreelJson);
const testimonialsPage = BaseWPSchema.parse(testimonialsPageJson);
const testimonials = TestimonialsSchema.parse(testimonialsJson);
const faqPage = SectionPageSchema.parse(faqPageJson);
const faqs = FaqsSchema.parse(faqsJson);
const homeFaqs = faqs.slice(0, 5); // home: the first 5 by "Order"

const blogPage = SectionPageSchema.parse(blogPageJson);
const posts = PostsSchema.parse(postsJson);
const homePosts = posts.slice(0, 3); // home: the 3 most recent

---

<Layout title="Inicio">
  <Hero
    slot="before-main-content"
    bgImage={bg.src}
    tag={hero.tag}
    greeting={hero.greeting}
    title={hero.title}
    highlightText={hero.highlight}
    description={hero.description}
    primaryCta={hero.primary_text ? { text: hero.primary_text, href: "#projects" } : undefined}
    secondaryCta={options.cv_file
      ? { text: hero.cv_text ?? t("hero.cv"), href: options.cv_file }
      : undefined}
    media={{ light: hero.image_light, dark: hero.image_dark, badgeText: hero.badge_text }}
  />
  <LogoMarquee slot="before-main-content" />

  <About
    label={about.title.rendered}
    heading={about.acf.heading}
    content={about.content.rendered}
    stats={about.acf.stats}
  />

    {
    stack.acf.skills.length > 0 && (
      <Stack
        label={stack.title.rendered}
        heading={stack.acf.heading}
        skills={stack.acf.skills}
      />
    )
  }

  {
    experiences.length > 0 && (
      <Experience
        label={experiencePage.title.rendered}
        heading={experiencePage.acf.heading}
        experiences={experiences}
      />
    )
  }


  {
    homeProjects.length > 0 && (
      <Projects
        label={projectsPage.title.rendered}
        heading={projectsPage.acf.heading}
        projects={homeProjects}
        moreLink={{ text: projectsPage.acf.cta_text || t("projects.more"), href: "/projects" }}
      />
    )
  }

  <Showreel
    label={showreel.title.rendered}
    video={showreel.acf.video}
    poster={showreel.acf.poster}
  />

  {
    testimonials.length > 0 && (
      <Testimonials
        label={testimonialsPage.title.rendered}
        testimonials={testimonials}
      />
    )
  }

    {
    homeFaqs.length > 0 && (
      <Faq
        label={faqPage.title.rendered}
        heading={faqPage.acf.heading}
        intro={faqPage.content.rendered}
        faqs={homeFaqs}
      />
    )
  }

    {
    homePosts.length > 0 && (
      <Blog
        label={blogPage.title.rendered}
        heading={blogPage.acf.heading}
        posts={homePosts}
        moreLink={{ text: blogPage.acf.cta_text || t("blog.more"), href: "/blog" }}
      />
    )
  }

</Layout>
