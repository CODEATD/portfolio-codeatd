---
// Layout
import Layout from "@/layouts/Layout.astro";

// Components
import Hero from "@/components/hero/Hero.astro";
import LogoMarquee from "@/components/ui/LogoMarquee.astro";
import About from "@/components/about/About.astro";
import Stack from "@/components/stack/Stack.astro";
import Experience from "@/components/experience/Experience.astro";
import Projects from "@/components/projects/Projects.astro";
import Showreel from "@/components/showreel/Showreel.astro";
import Testimonials from "@/components/testimonials/Testimonials.astro";
import Faq from "@/components/faq/Faq.astro";
import Blog from "@/components/blog/Blog.astro";

// Helpers
import { getOptions, getPageBySlug, getPostType } from "@/helpers";

// Types
import {
  AboutPageSchema,
  BaseWPSchema,
  ExperiencesSchema,
  FaqsSchema,
  OptionsSchema,
  PostsSchema,
  ProjectsSchema,
  SectionPageSchema,
  StackPageSchema,
  ShowreelPageSchema,
  TestimonialsSchema,
} from "@/types";
import bg from "@/assets/backgrounds/bg-pattern-dark.avif";

const options = OptionsSchema.parse(await getOptions());
const about = AboutPageSchema.parse(await getPageBySlug("about"));
const stack = StackPageSchema.parse(await getPageBySlug("stack"));
const experiencePage = SectionPageSchema.parse(
  await getPageBySlug("experience"),
);
const experiences = ExperiencesSchema.parse(await getPostType("experience"));
const projectsPage = SectionPageSchema.parse(await getPageBySlug("projects"));
const projects = ProjectsSchema.parse(await getPostType("project"));
const homeProjects = projects.slice(0, 4); // home: the 4 most recent
const showreel = ShowreelPageSchema.parse(await getPageBySlug("showreel"));
const testimonialsPage = BaseWPSchema.parse(
  await getPageBySlug("testimonials"),
);
const testimonials = TestimonialsSchema.parse(await getPostType("testimonial"));
const faqPage = SectionPageSchema.parse(await getPageBySlug("faq"));
const faqs = FaqsSchema.parse(
  await getPostType("faq", "&orderby=menu_order&order=asc"),
);
const homeFaqs = faqs.slice(0, 5); // home: the first 5 by "Order"

const blogPage = SectionPageSchema.parse(await getPageBySlug("blog"));
const posts = PostsSchema.parse(await getPostType("posts"));
const homePosts = posts.slice(0, 3); // home: the 3 most recent

---

<Layout title="Inicio">
  <Hero
    slot="before-main-content"
    bgImage={bg.src}
    secondaryCta={options.cv_file
      ? { text: "Download CV", href: options.cv_file }
      : undefined}
  />
  <LogoMarquee slot="before-main-content" />

  <About
    label={about.title.rendered}
    heading={about.acf.heading}
    content={about.content.rendered}
    stats={about.acf.stats}
  />

    {
    stack.acf.skills.length > 0 && (
      <Stack
        label={stack.title.rendered}
        heading={stack.acf.heading}
        skills={stack.acf.skills}
      />
    )
  }

  {
    experiences.length > 0 && (
      <Experience
        label={experiencePage.title.rendered}
        heading={experiencePage.acf.heading}
        experiences={experiences}
      />
    )
  }


  {
    homeProjects.length > 0 && (
      <Projects
        label={projectsPage.title.rendered}
        heading={projectsPage.acf.heading}
        projects={homeProjects}
      />
    )
  }

  <Showreel
    label={showreel.title.rendered}
    video={showreel.acf.video}
    poster={showreel.acf.poster}
  />

  {
    testimonials.length > 0 && (
      <Testimonials
        label={testimonialsPage.title.rendered}
        testimonials={testimonials}
      />
    )
  }

    {
    homeFaqs.length > 0 && (
      <Faq
        label={faqPage.title.rendered}
        heading={faqPage.acf.heading}
        intro={faqPage.content.rendered}
        faqs={homeFaqs}
      />
    )
  }

    {
    homePosts.length > 0 && (
      <Blog
        label={blogPage.title.rendered}
        heading={blogPage.acf.heading}
        posts={homePosts}
      />
    )
  }

</Layout>
