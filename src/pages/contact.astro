---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import LiveClock from "@/components/ui/LiveClock.astro";
import PostReveal from "@/components/blog/PostReveal.astro";
import ContactForm from "@/components/contact/ContactForm.astro";
import ClientsMap from "@/components/contact/ClientsMap.astro";
import { getOptions, getPageBySlug, toPlainText } from "@/helpers";
import { ContactPageSchema, OptionsSchema } from "@/types";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));

// Both requests at once
const [pageJson, optionsJson] = await Promise.all([
  getPageBySlug("contact"),
  getOptions(),
]);
const { title, content, acf } = ContactPageSchema.parse(pageJson);
const options = OptionsSchema.parse(optionsJson);

const markers = acf.clients_map?.markers ?? [];
---

<Layout
  title={title.rendered}
  description={toPlainText(content.rendered) || undefined}
>
  <div class="pt-12 pb-20 sm:pt-16 sm:pb-28 lg:pb-30">
    <Breadcrumb
      items={[{ name: t("breadcrumb.home"), href: "/" }, { name: title.rendered }]}
    />

    <!-- Label + h1 (word by word, like the blog posts: PostReveal) + intro -->
    <div
      class="mt-10 grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-8"
      data-post-reveal
    >
      <SectionHeading
        as="h1"
        class="lg:col-span-7"
        id="contact-title"
        label={title.rendered}
        heading={acf.heading}
        headingClass="post-title sm:text-5xl lg:text-6xl"
      />
      {content.rendered && (
        <div
          class="post-anim-item rich-text leading-relaxed text-pretty text-neutral-400 lg:col-span-4 lg:col-start-9 dark:text-neutral-50"
          set:html={content.rendered}
        />
      )}
    </div>
    <PostReveal />

    <section
      aria-labelledby="contact-title"
      class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-8"
    >
      <!-- Left: direct contact -->
      <div class="space-y-10 lg:col-span-5">
        {acf.availability && (
          <p class="inline-flex items-center gap-3 rounded-full border border-bor-light px-4 py-2 text-sm dark:border-neutral-400">
            <span class="relative flex size-2.5" aria-hidden="true">
              <span class="absolute inset-0 rounded-full bg-emerald-400 opacity-75 motion-safe:animate-ping" />
              <span class="relative size-2.5 rounded-full bg-emerald-500" />
            </span>
            {acf.availability}
          </p>
        )}

        <div>
          <p class="text-xs font-semibold tracking-[0.2em] text-neutral-300 uppercase dark:text-neutral-100">
            Email
          </p>
          <a
            href={`mailto:${options.contact_email}`}
            class="mt-3 inline-block font-heading text-2xl font-medium underline decoration-primary-500 decoration-2 underline-offset-8 transition-colors hover:text-primary-600 sm:text-3xl dark:hover:text-primary-500"
          >
            {options.contact_email}
          </a>
        </div>

        <div class="flex flex-wrap gap-x-12 gap-y-8">
          <div>
            <p class="text-xs font-semibold tracking-[0.2em] text-neutral-300 uppercase dark:text-neutral-100">
              {t("contact.basedIn")}
            </p>
            <!-- Same style as "Reply time"; the green dot stays only on "Available" -->
            <p class="mt-3">{options.contact_location}</p>
            <p class="mt-1 text-sm text-neutral-300 dark:text-neutral-100">
              <LiveClock variant="plain" /> {t("contact.localTime")}
            </p>
          </div>
          {acf.reply_time && (
            <div>
              <p class="text-xs font-semibold tracking-[0.2em] text-neutral-300 uppercase dark:text-neutral-100">
                {t("contact.replyTime")}
              </p>
              <p class="mt-3">{acf.reply_time}</p>
            </div>
          )}
        </div>

        {options.social_links.length > 0 && (
          <div>
            <p class="text-xs font-semibold tracking-[0.2em] text-neutral-300 uppercase dark:text-neutral-100">
              {t("contact.elsewhere")}
            </p>
            <ul class="mt-3 flex flex-wrap gap-3">
              {options.social_links.map(({ name, url, icon }) => (
                <li>
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="grid size-11 place-items-center rounded-full border border-bor-light text-xl transition-colors hover:border-neutral-500 dark:border-neutral-400 dark:hover:border-primary-500 dark:hover:text-primary-500"
                  >
                    <i class={icon} aria-hidden="true" />
                    <span class="sr-only">{name} {t("a11y.newTab")}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Right: the form -->
      <div class="lg:col-span-7 lg:col-start-6">
        <ContactForm />
      </div>
    </section>

    {markers.length > 0 && (
      <section aria-labelledby="clients-title" class="mt-24 sm:mt-32">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-semibold tracking-[0.2em] text-neutral-300 uppercase dark:text-neutral-100">
              {t("contact.worldwide")}
            </p>
            <h2
              id="clients-title"
              class="mt-4 font-heading text-3xl font-medium tracking-tight sm:text-4xl"
            >
              {t("contact.clientsIn")} {markers.length} {t("contact.countries")}
            </h2>
          </div>
          <!-- The same data as text: the map is hidden from screen readers -->
          <ul class="flex flex-wrap gap-2 text-sm">
            {markers.map(({ label }) => (
              <li class="rounded-full border border-bor-light px-3 py-1 dark:border-neutral-400">
                {label}
              </li>
            ))}
          </ul>
        </div>
        <div class="mt-8">
          <ClientsMap markers={markers} />
        </div>
      </section>
    )}
  </div>
</Layout>
