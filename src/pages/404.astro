---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found">
  <section class="grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 dark:text-primary-500">
        Error 404
      </p>
      <h1 class="mt-5 font-heading text-4xl font-medium tracking-tight text-neutral-500 sm:text-6xl dark:text-white">
        Page not found.
      </h1>
      <p class="mt-5 text-neutral-300 dark:text-neutral-100">
        The page you're looking for doesn't exist or was moved.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Back home</a>
        <a href="/blog" class="btn-outline">Read the blog</a>
      </div>
    </div>
  </section>
</Layout>
