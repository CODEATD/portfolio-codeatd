---
import { siteConfig } from "@/config/site-config.ts";
import Header from "@/components/header/Header.astro";
import Footer from "@/components/footer/Footer.astro";
import "@/styles/global.css";
import bg from "@/assets/backgrounds/bg-pattern-dark.png";

// Props for the layout component (SEO metadata)
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = siteConfig.description,
  image = siteConfig.ogImage,
} = Astro.props;

// Construct the full page title for SEO
const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.title;
---

<!doctype html>
<html lang="es" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <!-- SEO basics -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />

    <!-- Open Graph Social Media -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={siteConfig.url} />

    <script is:inline>
      // Function to get the initial theme based on localStorage or system preference
      const getInitialTheme = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        // If no theme is set in localStorage, check the user's system preference
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      };

      const theme = getInitialTheme();
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body
    class="bg-surface-light text-neutral-500 dark:bg-surface-dark dark:text-white min-h-screen flex flex-col"
  >
    <Header />
    <slot name="before-main-content" />
    <main class="flex-grow container">
      <slot />
    </main>
    <slot name="after-main-content" />
    <Footer bgImage={bg.src} />
  </body>
</html>
