---
import MainNav from "@/components/header/MainNav.astro";
import ThemeToggle from "@/components/ui/ThemeToggle.astro";
import Logo from "@/assets/logos/logo-circle.svg";
import MobileMenu from "@/components/header/MobileMenu.astro";
---

<header
  class="w-full sticky top-0 z-40 bg-surface-light dark:bg-surface-dark border-b border-bor-light dark:border-bor-dark transition-colors duration-300"
>
  <div
    class="max-w-7xl mx-auto px-4 py-3 md:px-8 flex items-center justify-between"
  >
    <!-- Logo  -->
    <a href="/" class="flex items-center gap-2 group" aria-label="Ir al inicio">
      <div
        class="size-12 rounded-full flex items-center justify-center overflow-hidden group-hover:scale-105 transition-transform"
      >
        <Logo class="size-12" />
      </div>
    </a>

    <div class="flex items-center gap-6 lg:gap-9">
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center">
        <MainNav />
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <a href="#contact" class="hidden md:inline-flex btn-primary">
          <span>Let's Talk</span>
          <i class="ri-arrow-right-up-line text-base"></i>
        </a>

        <ThemeToggle />

        <!-- Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden size-10 rounded-full bg-primary-500 flex flex-col items-center justify-center gap-1.5 focus:outline-none cursor-pointer hover:brightness-105 transition"
          aria-label="Abrir menú"
        >
          <span class="w-5 h-0.5 bg-neutral-500 rounded-full"></span>
          <span class="w-5 h-0.5 bg-neutral-500 rounded-full"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<MobileMenu />
