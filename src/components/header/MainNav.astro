---
import { navLinks } from "@/config/site-config";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};

// Base styles for all navigation links
const baseStyles =
  "link-split px-2 py-1 text-sm font-semibold transition-colors duration-200";

// Function to get the appropriate classes for each link based on its active state
const getLinkClasses = (href: string) => {
  return isActive(href)
    ? "font-bold text-primary-500 hover:text-neutral-500 focus-visible:text-neutral-500 dark:text-primary-400 dark:hover:text-black dark:focus-visible:text-black" // Active
    : "text-neutral-500 dark:text-white dark:hover:text-black dark:focus-visible:text-black"; // Inactive
};
---

<nav class="flex flex-col md:flex-row items-center gap-4 lg:gap-6">
  {
    navLinks.map((item) => (
      <a href={item.href} class={`${baseStyles} ${getLinkClasses(item.href)}`}>
        {item.name}
      </a>
    ))
  }
</nav>
