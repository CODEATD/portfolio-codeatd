---
import { navLinks } from "@/config/site-config";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};

// Base styles for all navigation links
const baseStyles = "text-sm font-semibold transition-colors duration-200";

// Function to get the appropriate classes for each link based on its active state
const getLinkClasses = (href: string) => {
  return isActive(href)
    ? "text-primary-500 dark:text-primary-400 font-bold" // Active
    : "text-neutral-500 hover:text-neutral-400 dark:text-white dark:hover:text-primary-500"; // Inactive
};
---

<nav class="flex flex-col md:flex-row items-center gap-6 lg:gap-8">
  {
    navLinks.map((item) => (
      <a href={item.href} class={`${baseStyles} ${getLinkClasses(item.href)}`}>
        {item.name}
      </a>
    ))
  }
</nav>
