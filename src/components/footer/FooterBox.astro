---
interface Props {
  heading: string;
  class?: string;
}

const { heading, class: className = "" } = Astro.props;
---

<div class={`space-y-4 ${className}`}>
  <h3 class="text-s font-bold uppercase tracking-widest text-primary-500">
    {heading}
  </h3>

  <div class="space-y-3 text-sm text-neutral-500 dark:text-text-muted">
    <slot />
  </div>
</div>
