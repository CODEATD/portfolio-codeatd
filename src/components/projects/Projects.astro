---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import type { Project } from "@/types";

interface Props {
  index?: string;
  label?: string;
  heading?: string;
  projects: Project[];
  moreLink?: { text: string; href: string }; // "View More Projects" → when /projects exists
  class?: string;
}

const {
  index = "04",
  label = "Selected Work",
  heading = "A few products I'm proud to have shipped.",
  projects,
  moreLink,
  class: className = "",
} = Astro.props;
---

<section
  id="projects"
  aria-labelledby="projects-title"
  class:list={["scroll-mt-20 pb-20 sm:pb-28 lg:pb-30", className]}
>
  <!-- Heading + optional "View More Projects" -->
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <SectionHeading
      class="projects-anim-item lg:max-w-2xl"
      id="projects-title"
      index={index}
      label={label}
      heading={heading}
      headingClass="lg:text-5xl"
    />
    {
      moreLink && (
        <a
          href={moreLink.href}
          class="projects-anim-item btn-primary self-start lg:self-auto"
        >
          {moreLink.text}
        </a>
      )
    }
  </div>

  <!-- Cards -->
  <ul class="mt-12 space-y-16 sm:mt-16 lg:space-y-20">
    {
      projects.map((project) => (
        <li>
          <ProjectCard project={project} />
        </li>
      ))
    }
  </ul>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let projectsTweens: gsap.core.Tween[] = [];

  function initProjectsReveal() {
    const projects = document.querySelector<HTMLElement>("#projects");
    if (!projects) return;
    destroyProjectsReveal();

    // Accessibility: no animation if the user prefers reduced motion
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // 1. Label + heading (+ button)
    projectsTweens.push(
      gsap.from(projects.querySelectorAll(".projects-anim-item"), {
        y: 35,
        autoAlpha: 0,
        duration: 0.85,
        ease: "power3.out",
        stagger: 0.1,
        scrollTrigger: { trigger: projects, start: "top 75%", once: true },
      }),
    );

    // 2. Each card when it reaches the screen (cards are tall: one trigger each)
    projects
      .querySelectorAll<HTMLElement>(".project-anim-card")
      .forEach((card) => {
        projectsTweens.push(
          gsap.from(card, {
            y: 40,
            autoAlpha: 0,
            duration: 0.8,
            ease: "power3.out",
            scrollTrigger: { trigger: card, start: "top 80%", once: true },
          }),
        );
      });
  }

  function destroyProjectsReveal() {
    projectsTweens.forEach((tween) => {
      tween.scrollTrigger?.kill();
      tween.kill();
    });
    projectsTweens = [];
  }

  // ClientRouter: page-load also runs on the first load
  document.addEventListener("astro:page-load", initProjectsReveal);
  document.addEventListener("astro:before-swap", destroyProjectsReveal);
</script>
