---
import { Picture } from "astro:assets";
import type { Project } from "@/types";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  project: Project;
  headingLevel?: "h2" | "h3"; // h3 in the home section, h2 on /projects (h1 is the page title)
  layout?: "home" | "gallery"; // gallery: half and half, or stacked inside a [data-view="grid"] list
}

const { project, headingLevel: Heading = "h3", layout = "home" } = Astro.props;
const gallery = layout === "gallery";
const { slug, title, category, description, liveUrl, repoUrl, image, technologies } = project;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<article
  class:list={[
    "project-anim-card group/card grid grid-cols-1 gap-6",
    gallery
      ? "lg:grid-cols-2 lg:items-center lg:gap-10 in-data-[view=grid]:gap-5 in-data-[view=grid]:lg:grid-cols-1 in-data-[view=grid]:lg:items-start"
      : "lg:grid-cols-12 lg:items-center lg:gap-8",
  ]}
>
  <!-- Image (transition:name → it slides to its new place when the /projects filter changes) -->
  <div
    class:list={["project-card-media overflow-hidden rounded-2xl", !gallery && "lg:col-span-5"]}
    transition:name={`project-image-${slug}`}
  >
    <Picture
      src={image.large.url}
      alt={`${t("projects.preview")} ${title}`}
      width={image.large.width}
      height={image.large.height}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      class="aspect-4/3 w-full object-cover transition-transform duration-500 group-hover/card:scale-[1.03] motion-reduce:transition-none"
    />
  </div>

  <!-- Category, title, description, technologies, actions -->
  <div class:list={["project-card-text", !gallery && "lg:col-span-6 lg:col-start-7"]}>
    {
      category && (
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-300 dark:text-primary-500">
          {category}
        </p>
      )
    }
    <Heading
      class="mt-3 font-heading text-2xl font-medium text-neutral-500 sm:text-3xl in-data-[view=grid]:sm:text-2xl dark:text-white"
    >
      <Fragment set:html={title} />
    </Heading>
    <p
      class="mt-3 max-w-md text-sm leading-relaxed text-pretty text-neutral-300 dark:text-neutral-200"
    >
      {description}
    </p>
    {
      technologies.length > 0 && (
        <p class="mt-3 text-xs font-medium text-neutral-500 dark:text-white">
          {technologies.join(" · ")}
        </p>
      )
    }

    <!-- Actions ("Leer la historia" → single-project branch) -->
    {
      (liveUrl || repoUrl) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {liveUrl && (
            <a href={liveUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">
              {t("projects.live")}
              <span class="sr-only">: {title} {t("a11y.newTab")}</span>
              <i class="ri-arrow-right-up-line" aria-hidden="true" />
            </a>
          )}
          {repoUrl && (
            <a href={repoUrl} class="btn-outline" target="_blank" rel="noopener noreferrer">
              <i class="ri-github-line" aria-hidden="true" />
              {t("projects.code")}
              <span class="sr-only">: {title} {t("a11y.newTab")}</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
