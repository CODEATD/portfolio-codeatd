---
import { Picture } from "astro:assets";
import type { Testimonial } from "@/types";

interface Props {
  index?: string;
  label?: string;
  testimonials: Testimonial[];
  class?: string;
}

const {
  index = "06",
  label = "Testimonios",
  testimonials,
  class: className = "",
} = Astro.props;

// Two copies of the list: the animation moves the track -50%, so it loops with no jump
const copies = [0, 1];
// Same pace whatever the number of cards: ~7 s per card
const duration = testimonials.length * 7;
---

<section
  id="testimonials"
  aria-labelledby="testimonials-title"
  class:list={["scroll-mt-20 pb-20 sm:pb-28 lg:pb-30", className]}
>
  <h2
    id="testimonials-title"
    class="testimonials-anim-item text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 dark:text-primary-500"
  >
    ({index}) {label}
  </h2>

  <!-- Marquee: CSS only. It pauses on hover with no jump, like the logo one -->
  <div
    class="testimonials-anim-item mt-10 ml-[calc(50%-50vw)] w-screen overflow-hidden sm:mt-12 motion-reduce:overflow-x-auto"
    style={`--marquee-duration: ${duration}s`}
  >
    <div
      class="flex w-max animate-marquee hover:[animation-play-state:paused] focus-within:[animation-play-state:paused] motion-reduce:animate-none"
    >
      {
        copies.map((copy) => (
          <ul class="flex shrink-0" aria-hidden={copy > 0 ? "true" : undefined}>
            {testimonials.map(({ name, quote, role, company, avatar }) => (
              <li class="w-[85vw] shrink-0 pr-6 sm:w-108">
                <figure class="flex h-full flex-col justify-between gap-8 rounded-3xl bg-neutral-50/30 p-8 sm:p-10 dark:bg-black-400">
                  <blockquote class="text-lg leading-relaxed text-pretty text-neutral-300 sm:text-xl dark:text-neutral-50">
                    <p>{quote}</p>
                  </blockquote>

                  <figcaption class="flex items-center gap-4">
                    {avatar ? (
                      <Picture
                        src={avatar.url}
                        alt=""
                        width={96}
                        height={96}
                        formats={["avif", "webp"]}
                        fallbackFormat="jpg"
                        class="size-12 shrink-0 rounded-full object-cover dark:ring-2 dark:ring-white"
                      />
                    ) : (
                      <span
                        class="grid size-12 shrink-0 place-items-center rounded-full bg-primary-500 font-heading text-lg font-semibold text-neutral-500"
                        aria-hidden="true"
                      >
                        {name.charAt(0)}
                      </span>
                    )}
                    <div>
                      <p class="font-medium text-neutral-500 dark:text-white" set:html={name} />
                      <p class="text-sm text-neutral-300 dark:text-primary-500">
                        {[role, company].filter(Boolean).join(" · ")}
                      </p>
                    </div>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let testimonialsTween: gsap.core.Tween | null = null;

  function initTestimonials() {
    const section = document.querySelector<HTMLElement>("#testimonials");
    if (!section) return;
    destroyTestimonials();

    // Accessibility: no entrance animation if the user prefers reduced motion
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // Entrance animation (label + row); the row itself scrolls with CSS
    testimonialsTween = gsap.from(
      section.querySelectorAll(".testimonials-anim-item"),
      {
        y: 35,
        autoAlpha: 0,
        duration: 0.85,
        ease: "power3.out",
        stagger: 0.12,
        scrollTrigger: { trigger: section, start: "top 75%", once: true },
      },
    );
  }

  function destroyTestimonials() {
    testimonialsTween?.scrollTrigger?.kill();
    testimonialsTween?.kill();
    testimonialsTween = null;
  }

  // ClientRouter: page-load also runs on the first load
  document.addEventListener("astro:page-load", initTestimonials);
  document.addEventListener("astro:before-swap", destroyTestimonials);
</script>
