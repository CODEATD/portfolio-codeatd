---
// src/components/ui/MainNav.astro

const navigation = [
  { name: "About", href: "#about" },
  { name: "Experience", href: "#experience" },
  { name: "Projects", href: "#projects" },
  { name: "Blog", href: "#blog" }, // Tenías "Blog" duplicado dos veces, dejamos uno
  { name: "Contact", href: "#contact" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};

// Estilos base que comparten todos los enlaces
const baseStyles = "text-sm font-semibold transition-colors duration-200";

// Función centralizada para decidir los estilos activo vs inactivo
const getLinkClasses = (href: string) => {
  return isActive(href)
    ? "text-primary-500 dark:text-primary-400 font-bold" // Active
    : "text-neutral-600 hover:text-black dark:text-neutral-300 dark:hover:text-primary-400"; // Inactive
};
---

<nav class="flex flex-col md:flex-row items-center gap-6 lg:gap-8">
  {
    navigation.map((item) => (
      <a href={item.href} class={`${baseStyles} ${getLinkClasses(item.href)}`}>
        {item.name}
      </a>
    ))
  }
</nav>
