---

---

<button
  id="theme-toggle"
  type="button"
  class="size-10 rounded-full flex items-center justify-center text-neutral-500 hover:text-black hover:bg-neutral-100/10 dark:text-white dark:hover:text-primary-500 dark:hover:bg-neutral-50/10 transition-colors cursor-pointer relative overflow-hidden"
  aria-label="Cambiar tema de color"
>
  <!-- SVG Sun -->
  <svg
    id="icon-sun"
    class="size-5 hidden dark:block"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
  >
    <!-- Ring outline -->
    <path
      id="sun-ring"
      d="M12 18C8.68629 18 6 15.3137 6 12C6 8.68629 8.68629 6 12 6C15.3137 6 18 8.68629 18 12C18 15.3137 15.3137 18 12 18ZM12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16Z"
    ></path>
    <!-- Rays -->
    <g id="sun-rays">
      <path class="sun-ray" d="M11 1H13V4H11V1ZM11 20H13V23H11V20Z"></path>
      <path
        class="sun-ray"
        d="M3.51472 4.92893L4.92893 3.51472L7.05025 5.63604L5.63604 7.05025L3.51472 4.92893ZM16.9497 18.364L18.364 16.9497L20.4853 19.0711L19.0711 20.4853L16.9497 18.364Z"
      ></path>
      <path
        class="sun-ray"
        d="M19.0711 3.51472L20.4853 4.92893L18.364 7.05025L16.9497 5.63604L19.0711 3.51472ZM5.63604 16.9497L7.05025 18.364L4.92893 20.4853L3.51472 19.0711L5.63604 16.9497Z"
      ></path>
      <path class="sun-ray" d="M23 11V13H20V11H23ZM4 11V13H1V11H4Z"></path>
    </g>
  </svg>

  <!-- SVG moon -->
  <svg
    id="icon-moon"
    class="size-5 block dark:hidden"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
  >
    <!-- Body moon outline -->
    <path
      id="moon-body"
      d="M10 6C10 10.4183 13.5817 14 18 14C19.4386 14 20.7885 13.6203 21.9549 12.9556C21.4738 18.0302 17.2005 22 12 22C6.47715 22 2 17.5228 2 12C2 6.79948 5.9698 2.52616 11.0444 2.04507C10.3797 3.21152 10 4.56142 10 6ZM4 12C4 16.4183 7.58172 20 12 20C14.9654 20 17.5757 18.3788 18.9571 15.9546C18.6407 15.9848 18.3214 16 18 16C12.4772 16 8 11.5228 8 6C8 5.67863 8.01524 5.35933 8.04536 5.04293C5.62119 6.42426 4 9.03458 4 12Z"
    ></path>
    <!-- Stars: animation popup -->
    <g id="moon-stars">
      <path
        class="moon-star"
        d="M18.1642 2.29104L19 2.5V3.5L18.1642 3.70896C17.4476 3.8881 16.8881 4.4476 16.709 5.16417L16.5 6H15.5L15.291 5.16417C15.1119 4.4476 14.5524 3.8881 13.8358 3.70896L13 3.5V2.5L13.8358 2.29104C14.5524 2.1119 15.1119 1.5524 15.291 0.835829L15.5 0H16.5L16.709 0.835829C16.8881 1.5524 17.4476 2.1119 18.1642 2.29104Z"
      ></path>
      <path
        class="moon-star"
        d="M23.1642 7.29104L24 7.5V8.5L23.1642 8.70896C22.4476 8.8881 21.8881 9.4476 21.709 10.1642L21.5 11H20.5L20.291 10.1642C20.1119 9.4476 19.5524 8.8881 18.8358 8.70896L18 8.5V7.5L18.8358 7.29104C19.5524 7.1119 20.1119 6.5524 20.291 5.83583L20.5 5H21.5L21.709 5.83583C21.8881 6.5524 22.4476 7.1119 23.1642 7.29104Z"
      ></path>
    </g>
  </svg>
</button>

<script>
  import { gsap } from "gsap";

    const toggleBtn = document.getElementById("theme-toggle");

    function animateSun() {
      const tl = gsap.timeline();

      // The sun icon rotates into view, and the rays appear with a scale and opacity effect
      tl.fromTo(
        "#icon-sun",
        { rotation: -45, transformOrigin: "center" },
        { rotation: 0, duration: 0.45, ease: "power2.out" },
      )
        // The ring outline appears with a scale and opacity effect
        .fromTo(
          "#sun-ring",
          { scale: 0.4, opacity: 0, transformOrigin: "center" },
          { scale: 1, opacity: 1, duration: 0.35, ease: "back.out(2)" },
          "-=0.4",
        )

        // The rays appear with a scale and opacity effect, staggered for a twinkling effect
        .fromTo(
          ".sun-ray",
          { scale: 0, opacity: 0, transformOrigin: "center" },
          {
            scale: 1,
            opacity: 1,
            duration: 0.25,
            stagger: 0.03,
            ease: "power2.out",
          },
          "-=0.2",
        );
    }

    function animateMoon() {
      const tl = gsap.timeline();
      // The moon body appears with a rotation and scale effect
      tl.fromTo(
        "#moon-body",
        { rotation: -35, scale: 0.6, opacity: 0, transformOrigin: "center" },
        {
          rotation: 0,
          scale: 1,
          opacity: 1,
          duration: 0.45,
          ease: "back.out(2)",
        },
      )
        // The stars appear with a scale and opacity effect, staggered for a twinkling effect
        .fromTo(
          ".moon-star",
          { scale: 0, opacity: 0, transformOrigin: "center" },
          {
            scale: 1,
            opacity: 1,
            duration: 0.3,
            stagger: 0.1,
            ease: "back.out(2.5)",
          },
          "-=0.25",
        );
    }

    toggleBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');

      if (isDark) {
        animateSun();
      } else {
        animateMoon();
      }
    });
  </script>
