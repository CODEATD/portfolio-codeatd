---
interface Props {
  index?: string; // "01" (optional: pages show the label without number)
  label: string; // "About"
  heading: string;
  id: string; // for aria-labelledby on the <section>
  as?: "h1" | "h2"; // h1 on pages like /blog, h2 on home sections
  class?: string; // wrapper: layout + animation class
  headingClass?: string; // extra heading sizes
}

const {
  index,
  label,
  heading,
  id,
  as: Heading = "h2",
  class: className = "",
  headingClass = "",
} = Astro.props;
---

<div class={className}>
  <p
    class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 dark:text-primary-500"
  >
    {index && `(${index}) `}{label}
  </p>
  <Heading
    {id}
    class:list={[
      "mt-5 text-3xl font-medium leading-tight tracking-tight text-balance text-neutral-500 sm:text-4xl dark:text-white",
      headingClass,
    ]}
  >
    {heading}
  </Heading>
</div>