---
interface Crumb {
  name: string;
  href?: string; // last crumb (current page) has no link
}

interface Props {
  items: Crumb[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center gap-2 text-sm text-neutral-300 dark:text-neutral-100">
    {
      items.map(({ name, href }, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {href ? (
            <a href={href} class="transition-colors hover:text-neutral-500 dark:hover:text-white">
              <Fragment set:html={name} />
            </a>
          ) : (
            <span aria-current="page" class="line-clamp-1 text-neutral-500 dark:text-primary-500">
              <Fragment set:html={name} />
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>