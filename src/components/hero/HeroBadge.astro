---
// src/components/hero/HeroBadge.astro
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  class?: string;
  altText?: string;
  text?: string;
}

const t = useTranslations(getLangFromUrl(Astro.url));

const {
  class: className = "",
  altText = "Insignia interactiva de bienvenida",
  text = t("hero.badge"),
} = Astro.props;
---

<div
  id="hero-badge"
  class={`size-14 sm:size-20 rounded-full bg-primary-500 text-neutral-500 shadow-xl flex items-center justify-center relative overflow-hidden select-none z-30 cursor-pointer hover:scale-105 active:scale-95 transition-transform duration-300 ${className}`}
  aria-label={altText}
  role="img"
>
  <!-- State 1: Waving hand -->
  <div
    class="badge-icon-hand absolute inset-0 flex items-center justify-center"
  >
    <div
      class="hand-rotator inline-flex items-center justify-center origin-[70%_90%]"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="w-7 h-7 sm:w-10 sm:h-10 text-neutral-500"
      >
        <path
          d="M12.5002 2C12.2241 2 12.0002 2.22386 12.0002 2.5V12H10.0002V4.5C10.0002 4.22386 9.77634 4 9.5002 4C9.22405 4 9.0002 4.22386 9.0002 4.5V14C8.64653 14 7.00024 14 7.00024 14C6.61911 12.3792 5.64236 11.4407 4.5954 11.3216C4.87926 12.0664 5.36117 13.2592 6.16634 15.0995C7.02511 17.0622 7.89128 18.5218 9.00374 19.4986C10.0783 20.442 11.4586 21 13.5002 21C16.5378 21 19.0002 18.5377 19.0002 15.5002V7C19.0002 6.72386 18.7763 6.5 18.5002 6.5C18.2241 6.5 18.0002 6.72386 18.0002 7V12H16.0002V4C16.0002 3.72386 15.7763 3.5 15.5002 3.5C15.2241 3.5 15.0002 3.72386 15.0002 4V12H13.0002V2.5C13.0002 2.22386 12.7763 2 12.5002 2ZM21.0002 15.5002C21.0002 19.6424 17.6423 23 13.5002 23C11.0417 23 9.17214 22.308 7.68416 21.0015C6.23411 19.7283 5.22528 17.9381 4.33405 15.9012C3.40393 13.7753 2.89004 12.4804 2.60991 11.7235C2.25318 10.7597 2.74616 9.41212 4.08583 9.31846C5.24076 9.23771 6.22061 9.61249 7.0002 10.2587V4.5C7.0002 3.11929 8.11949 2 9.5002 2C9.68522 2 9.86554 2.0201 10.0391 2.05823C10.2477 0.888227 11.2702 0 12.5002 0C13.5602 0 14.4661 0.659694 14.8298 1.59091C15.0431 1.53167 15.268 1.5 15.5002 1.5C16.8809 1.5 18.0002 2.61929 18.0002 4V4.55001C18.1618 4.51722 18.329 4.5 18.5002 4.5C19.8809 4.5 21.0002 5.61929 21.0002 7V15.5002Z"
        ></path>
      </svg>
    </div>
  </div>

  <!-- State 2: Alternate text ("¡Hola!") -->
  <div
    class="badge-icon-text absolute inset-0 flex items-center justify-center font-heading font-black text-base sm:text-2xl text-neutral-500 opacity-0 pointer-events-none"
  >
    <span>{text}</span>
  </div>

  <!-- State 3: Light bulb / Idea RemixIcon -->
  <div
    class="badge-icon-bulb absolute inset-0 flex items-center justify-center text-neutral-500 opacity-0 pointer-events-none"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="w-7 h-7 sm:w-10 sm:h-10 text-neutral-500"
    >
      <path
        d="M12.3389 2.0088L12 4.00001C8.68631 4.00001 6.00003 6.68633 6 10C6 11.3842 6.46775 12.6914 7.31445 13.7481C7.39984 13.8546 8.12027 14.6007 8.23145 14.7217C9.22754 15.8063 9.84058 16.7984 9.97266 18H14.0273C14.1594 16.7985 14.7721 15.8065 15.7676 14.7227C15.8796 14.6007 16.5977 13.857 16.6836 13.75C17.5313 12.693 18 11.385 18 10L19.9902 9.66017C19.9949 9.77288 20 9.88614 20 10C20 11.8924 19.3426 13.6312 18.2441 15.001C17.6238 15.7744 16 17 16 18.5V21C16 22.1046 15.1046 23 14 23H10C8.89543 23 8 22.1046 8 21V18.5C7.99996 17 6.37453 15.7734 5.75391 14.999C4.65647 13.6296 4 11.8915 4 10C4.00003 5.58176 7.58174 2.00001 12 2.00001C12.1135 2.00001 12.2265 2.00411 12.3389 2.0088ZM10 21H14V20H10V21ZM17.5293 0.328369C17.7059 -0.0974062 18.2942 -0.0974181 18.4707 0.328369L18.7236 0.939698C19.1556 1.98249 19.9616 2.81521 20.9746 3.26587L21.6924 3.58521C22.1026 3.76803 22.1026 4.36522 21.6924 4.5481L20.9326 4.88599C19.9449 5.32526 19.1534 6.12849 18.7139 7.13696L18.4668 7.70239C18.2864 8.11652 17.7137 8.11652 17.5332 7.70239L17.2871 7.13696C16.8476 6.12833 16.0552 5.32531 15.0674 4.88599L14.3076 4.5481C13.8975 4.36524 13.8974 3.76801 14.3076 3.58521L15.0254 3.26587C16.0385 2.81521 16.8445 1.9825 17.2764 0.939698L17.5293 0.328369Z"
      ></path>
    </svg>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  let badgeTimeline: gsap.core.Timeline | null = null;
  let activeBadge: HTMLElement | null = null;

  function initBadgeAnimation() {
    const badge = document.querySelector<HTMLElement>("#hero-badge");
    if (!badge || badge === activeBadge) return;

    badgeTimeline?.kill();

    const hand = badge.querySelector<HTMLElement>(".badge-icon-hand");
    const handRotator = badge.querySelector<HTMLElement>(".hand-rotator");
    const text = badge.querySelector<HTMLElement>(".badge-icon-text");
    const bulb = badge.querySelector<HTMLElement>(".badge-icon-bulb");

    if (!badge || !hand || !handRotator || !text || !bulb) return;

    activeBadge = badge;

    // Reset the initial states
    gsap.set(hand, { y: 0, autoAlpha: 0 });
    gsap.set(handRotator, { rotation: 0, transformOrigin: "70% 90%" });
    gsap.set(text, { y: -35, autoAlpha: 0 });
    gsap.set(bulb, { scale: 0.3, y: -20, autoAlpha: 0 });

    // Infinite loop timeline: smooth, continuous carousel cycle
    badgeTimeline = gsap.timeline({
      repeat: -1,
      defaults: { ease: "power2.inOut" },
    });

    badgeTimeline
      // 1. The hand drops in from above
      .fromTo(
        hand,
        { y: -45, autoAlpha: 0 },
        {
          y: 0,
          autoAlpha: 1,
          duration: 0.45,
          ease: "back.out(1.7)",
        },
      )
      // 2. Natural fan-like waving motion
      .to(handRotator, {
        keyframes: [
          { rotation: 22, duration: 0.16 },
          { rotation: -20, duration: 0.18 },
          { rotation: 18, duration: 0.18 },
          { rotation: -16, duration: 0.18 },
          { rotation: 12, duration: 0.16 },
          { rotation: 0, duration: 0.14 },
        ],
        ease: "power1.inOut",
        transformOrigin: "70% 90%",
      })
      // 3. Brief pause with the hand at rest
      .to({}, { duration: 0.35 })
      // 4. The hand exits downward
      .to(hand, {
        y: 45,
        autoAlpha: 0,
        duration: 0.35,
        ease: "power2.in",
      })
      // 5. The text drops in from above
      .fromTo(
        text,
        { y: -35, autoAlpha: 0 },
        {
          y: 0,
          autoAlpha: 1,
          duration: 0.4,
          ease: "back.out(1.7)",
        },
      )
      // 6. Reading pause for the text, then exits downward
      .to(
        text,
        {
          y: 45,
          autoAlpha: 0,
          duration: 0.35,
          ease: "power2.in",
        },
        "+=1.5",
      )
      // 7. The light bulb drops in with a scale-up pop effect
      .fromTo(
        bulb,
        { scale: 0.3, y: -20, autoAlpha: 0 },
        {
          scale: 1,
          y: 0,
          autoAlpha: 1,
          duration: 0.45,
          ease: "back.out(2)",
        },
      )
      // 8. Pause with the light bulb, then exit downward
      .to(
        bulb,
        {
          y: 45,
          autoAlpha: 0,
          duration: 0.35,
          ease: "power2.in",
        },
        "+=1.5",
      );
  }

  function destroyBadgeAnimation() {
    badgeTimeline?.kill();
    badgeTimeline = null;
    activeBadge = null;
  }

  // ClientRouter: page-load also runs on the first load
  document.addEventListener("astro:page-load", initBadgeAnimation);
  document.addEventListener("astro:before-swap", destroyBadgeAnimation);
</script>
