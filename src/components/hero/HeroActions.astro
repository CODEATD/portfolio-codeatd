---
// src/components/hero/HeroActions.astro
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  primaryCta?: {
    text: string;
    href: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
  };
  class?: string;
}

const t = useTranslations(getLangFromUrl(Astro.url));

const {
  primaryCta = { text: t("hero.primary"), href: "#projects" },
  secondaryCta,
  class: className = "",
} = Astro.props;
---

<div class={`flex flex-wrap items-center gap-5 sm:gap-7 ${className}`}>
  <!-- Primary Button -->
  <a
    href={primaryCta.href}
    class="btn-primary bg-primary-500 text-neutral-500 hover:bg-primary-400 dark:text-neutral-500 px-7 py-3.5 text-sm sm:text-base"
  >
    <span>{primaryCta.text}</span>
    <i
      class="ri-arrow-down-line text-lg inline-block animate-float-arrow"
      aria-hidden="true"
    ></i>
  </a>

  <!-- Secondary Button (only when there is a CV) -->
  {
    secondaryCta && (
      <a
        href={secondaryCta.href}
        class="btn-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="mr-2">{secondaryCta.text}</span>
        <i class="ri-arrow-right-up-line text-lg" aria-hidden="true" />
      </a>
    )
  }
</div>