<!-- Copy buttons of the code blocks (markup comes from highlightCode) -->
<script>
  function initCodeCopy() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-code]").forEach((button) => {
      button.onclick = async () => {
        const code = button.closest(".code-block")?.querySelector("code")?.innerText ?? "";
        await navigator.clipboard.writeText(code);

        // Feedback: check icon for 2 s
        const icon = button.querySelector("i");
        const label = button.getAttribute("aria-label") ?? "";
        icon?.classList.replace("ri-file-copy-line", "ri-check-line");
        button.setAttribute("aria-label", button.dataset.doneLabel ?? label);
        setTimeout(() => {
          icon?.classList.replace("ri-check-line", "ri-file-copy-line");
          button.setAttribute("aria-label", label);
        }, 2000);
      };
    });
  }

  // ClientRouter: page-load also runs on the first load
  document.addEventListener("astro:page-load", initCodeCopy);
</script>
