---
import type { Page } from "astro";

interface Props {
  page: Page; // from paginate(): currentPage, lastPage, url.first/current
}

const { page } = Astro.props;

// Page 1 URL ("/blog" or "/blog/category/astro"); page N is "base/page/N" (withPagePrefix)
const base = page.url.first ?? page.url.current; // first is undefined on page 1 itself
const href = (n: number) => (n === 1 ? base : `${base}/page/${n}`);
const prev = page.currentPage > 1 ? href(page.currentPage - 1) : undefined;
const next = page.currentPage < page.lastPage ? href(page.currentPage + 1) : undefined;
const numbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);

const arrow =
  "grid size-10 place-items-center rounded-full border border-bor-light text-lg transition-colors dark:border-neutral-400";
---

{
  page.lastPage > 1 && (
    <nav aria-label="Pagination" class="mt-16 flex items-center justify-center gap-2">
      {prev ? (
        <a href={prev} class:list={[arrow, "hover:border-neutral-500 dark:hover:border-white"]}>
          <i class="ri-arrow-left-line" aria-hidden="true" />
          <span class="sr-only">Previous page</span>
        </a>
      ) : (
        <span class:list={[arrow, "opacity-40"]} aria-hidden="true">
          <i class="ri-arrow-left-line" />
        </span>
      )}

      {numbers.map((n) => (
        <a
          href={href(n)}
          aria-current={n === page.currentPage ? "page" : undefined}
          class:list={[
            "grid size-10 place-items-center rounded-full text-sm font-medium transition-colors",
            n === page.currentPage
              ? "bg-neutral-500 text-white dark:bg-primary-500 dark:text-neutral-500"
              : "text-neutral-400 hover:bg-neutral-50/40 dark:text-neutral-50 dark:hover:bg-black-400",
          ]}
        >
          <span class="sr-only">Page </span>
          {n}
        </a>
      ))}

      {next ? (
        <a href={next} class:list={[arrow, "hover:border-neutral-500 dark:hover:border-white"]}>
          <i class="ri-arrow-right-line" aria-hidden="true" />
          <span class="sr-only">Next page</span>
        </a>
      ) : (
        <span class:list={[arrow, "opacity-40"]} aria-hidden="true">
          <i class="ri-arrow-right-line" />
        </span>
      )}
    </nav>
  )
}