---
import { formatDate } from "@/helpers";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));

interface Props {
  date: string; // ISO date from WordPress
  readingTime: number; // minutes
  class?: string;
}

const { date, readingTime, class: className = "" } = Astro.props;
---

<p
  class:list={[
    "flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-neutral-300 dark:text-neutral-100",
    className,
  ]}
>
  <span class="inline-flex items-center gap-1.5">
    <i class="ri-calendar-line text-sm text-neutral-500 dark:text-primary-500" aria-hidden="true" />
    <time datetime={date}>{formatDate(date)}</time>
  </span>
  <span class="inline-flex items-center gap-1.5">
    <i class="ri-time-line text-sm text-neutral-500 dark:text-primary-500" aria-hidden="true" />
    {readingTime} {t("blog.minRead")}
  </span>
</p>