---
import { Picture } from "astro:assets";
import PostMeta from "@/components/blog/PostMeta.astro";
import type { Post } from "@/types";

interface Props {
  post: Post;
  headingLevel?: "h2" | "h3"; // h3 in the home section, h2 on /blog (h1 is the page title)
  class?: string;
}

const { post, headingLevel: Heading = "h3", class: className = "" } = Astro.props;
const { slug, title, date, excerpt, image, categories, readingTime } = post;
const category = categories[0]; // card label: first category
---

<article class:list={["group/post relative flex h-full flex-col", className]}>
  <!-- Image + category (transition:name → it grows into the post's image, Fernando 3.12) -->
  <div
    class="relative overflow-hidden rounded-3xl bg-neutral-50/40 dark:bg-black-400"
    transition:name={`post-image-${slug}`}
  >
    {
      image ? (
        <Picture
          src={image.medium_large.url}
          alt=""
          width={image.medium_large.width}
          height={image.medium_large.height}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          class="aspect-4/3 w-full object-cover transition-transform duration-500 group-hover/post:scale-[1.03] motion-reduce:transition-none"
        />
      ) : (
        <div class="aspect-4/3" />
      )
    }
    {
      category && (
        <span class="absolute top-4 left-4 rounded-full bg-black/40 px-3 py-1 text-xs font-medium text-white backdrop-blur-md">
          {category.name}
        </span>
      )
    }
  </div>

  <PostMeta class="mt-5" date={date} readingTime={readingTime} />

  <Heading
    class="mt-3 font-heading text-2xl font-semibold uppercase leading-tight text-neutral-500 dark:text-white"
  >
    <a
      href={`/blog/${slug}`}
      class="after:absolute after:inset-0 after:rounded-3xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-primary-500"
    >
      <Fragment set:html={title} />
    </a>
  </Heading>

  <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-neutral-300 dark:text-neutral-100">
    {excerpt}
  </p>

  <span
    class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-medium text-neutral-500 dark:text-white"
    aria-hidden="true"
  >
    Read post
    <i class="ri-arrow-right-up-line transition-transform duration-300 group-hover/post:translate-x-0.5 group-hover/post:-translate-y-0.5" />
  </span>
</article>